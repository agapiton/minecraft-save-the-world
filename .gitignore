# Игнорируем всё в корне инстанса...
/*

# ...кроме того, что настраиваем сами
!/.gitignore
!/README.md
!/ROADMAP.md
!/config/
!/defaultconfigs/
!/kubejs/
!/minecraftinstance.json
!/sync.bat
!/.gitattributes

# Мусор, который генерирует KubeJS
/kubejs/exported/
/kubejs/probe/

# Резервные копии конфигов
*.bak
*.old